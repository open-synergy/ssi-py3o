<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="py3o_template_form_view_include_code" model="ir.ui.view">
        <field name="name">py3o.template.form.include.code</field>
        <field name="model">py3o.template</field>
        <field
            name="inherit_id"
            ref="report_py3o.py3o_template_configuration_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='filetype']" position="after">
                <field name="include_code" />
            </xpath>
        </field>
    </record>
</odoo>
